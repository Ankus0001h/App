#:import utils kivy.utils

<RegisterScreen>:
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex('#F8FAFC')  # Soft slate clean background
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        # Compact Modern Card Container
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            width: dp(340)
            height: dp(510)  # Reduced card height for modern proportions
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            padding: [dp(20), dp(18)]
            spacing: dp(6)
            
            canvas.before:
                # Soft Subdued Shadow Layer
                Color:
                    rgba: 0, 0, 0, 0.05
                RoundedRectangle:
                    pos: self.x - dp(2), self.y - dp(3)
                    size: self.width + dp(4), self.height + dp(5)
                    radius: [dp(18)]
                # Subtle Border
                Color:
                    rgba: utils.get_color_from_hex('#CBD5E1')
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16)]
                # Main White Container
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.x + 1, self.y + 1
                    size: self.width - 2, self.height - 2
                    radius: [dp(15)]

            # App Logo Header
            AnchorLayout:
                size_hint_y: None
                height: dp(48)
                anchor_x: 'center'
                anchor_y: 'center'
                Image:
                    source: 'assets/logo.jpeg'
                    size_hint: None, None
                    size: dp(44), dp(44)
                    allow_stretch: True
                    keep_ratio: True

            # Brand Header Title
            Label:
                text: 'Create Account'
                font_size: '20sp'
                bold: True
                color: utils.get_color_from_hex('#0F172A') # Pitch Dark Slate
                size_hint_y: None
                height: dp(24)
                halign: 'center'
                valign: 'middle'
                
            # Quick Commerce Tagline
            Label:
                text: 'Groceries delivered in 10 minutes ⚡'
                font_size: '11sp'
                color: utils.get_color_from_hex('#475569')
                size_hint_y: None
                height: dp(18)
                text_size: self.width, None
                halign: 'center'
                valign: 'middle'

            # ---------------- 1. FULL NAME SECTION ----------------
            Label:
                text: 'Full Name'
                font_size: '11.5sp'
                bold: True
                color: utils.get_color_from_hex('#0F172A')  # Crisp Dark Label
                size_hint_y: None
                height: dp(16)
                text_size: self.width, None
                halign: 'left'

            TextInput:
                id: name_input
                hint_text: 'e.g. Ankush Sachan'
                hint_text_color: utils.get_color_from_hex('#94A3B8')
                multiline: False
                write_tab: False
                size_hint_y: None
                height: dp(38)
                font_size: '13sp'
                cursor_color: utils.get_color_from_hex('#0B8733')
                foreground_color: utils.get_color_from_hex('#000000')  # Solid Black Text
                padding: [dp(10), dp(9), dp(10), dp(9)]
                background_normal: ''
                background_active: ''
                background_color: utils.get_color_from_hex('#F1F5F9')  # Soft Grey Tint
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#94A3B8')  # High-contrast border
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
                        width: 1

            # ---------------- 2. EMAIL SECTION ----------------
            Label:
                text: 'Email Address'
                font_size: '11.5sp'
                bold: True
                color: utils.get_color_from_hex('#0F172A')  # Crisp Dark Label
                size_hint_y: None
                height: dp(16)
                text_size: self.width, None
                halign: 'left'

            TextInput:
                id: email_input
                hint_text: 'name@example.com'
                hint_text_color: utils.get_color_from_hex('#94A3B8')
                multiline: False
                write_tab: False
                size_hint_y: None
                height: dp(38)
                font_size: '13sp'
                cursor_color: utils.get_color_from_hex('#0B8733')
                foreground_color: utils.get_color_from_hex('#000000')  # Solid Black Text
                padding: [dp(10), dp(9), dp(10), dp(9)]
                background_normal: ''
                background_active: ''
                background_color: utils.get_color_from_hex('#F1F5F9')
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#94A3B8')
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
                        width: 1

            # ---------------- 3. MOBILE NUMBER SECTION ----------------
            Label:
                text: 'Mobile Number'
                font_size: '11.5sp'
                bold: True
                color: utils.get_color_from_hex('#0F172A')  # Crisp Dark Label
                size_hint_y: None
                height: dp(16)
                text_size: self.width, None
                halign: 'left'

            BoxLayout:
                size_hint_y: None
                height: dp(38)
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#F1F5F9')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]
                    Color:
                        rgba: utils.get_color_from_hex('#94A3B8')
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
                        width: 1

                Label:
                    text: '+91'
                    bold: True
                    halign: 'center'
                    valign: 'middle'
                    color: utils.get_color_from_hex('#0F172A')  # Solid Black Code
                    font_size: '13sp'
                    size_hint_x: None
                    width: dp(40)

                Widget:
                    size_hint_x: None
                    width: dp(1)
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex('#CBD5E1')
                        Rectangle:
                            pos: self.x, self.y + dp(6)
                            size: 1, self.height - dp(12)

                TextInput:
                    id: phone_input
                    hint_text: '10-digit mobile number'
                    hint_text_color: utils.get_color_from_hex('#94A3B8')
                    multiline: False
                    write_tab: False
                    input_filter: 'int'
                    input_type: 'number'
                    font_size: '13sp'
                    cursor_color: utils.get_color_from_hex('#0B8733')
                    foreground_color: utils.get_color_from_hex('#000000')  # Solid Black Text
                    padding: [dp(8), dp(9), dp(8), dp(9)]
                    background_normal: ''
                    background_active: ''
                    background_color: 0, 0, 0, 0

            # Error Display Label
            Label:
                id: error_label
                text: ''
                color: utils.get_color_from_hex('#DC2626')
                font_size: '11sp'
                size_hint_y: None
                height: dp(14)
                text_size: self.width, None
                halign: 'center'

            # Primary CTA Button
            Button:
                text: 'Continue & Verify OTP'
                size_hint_y: None
                height: dp(42)
                background_color: 0, 0, 0, 0
                background_normal: ''
                color: 1, 1, 1, 1
                bold: True
                font_size: '14sp'
                on_release: root.request_register()
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#0B8733')  # Fresh Grocery Green
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]

            # Login Redirect Link
            Button:
                text: "Already have an account? [color=#0B8733][b]Login[/b][/color]"
                markup: True
                size_hint_y: None
                height: dp(26)
                background_color: 0, 0, 0, 0
                background_normal: ''
                color: utils.get_color_from_hex('#475569')
                font_size: '12sp'
                on_release:
                    app.root.current = 'login'
                    app.root.transition.direction = 'right'

        # Safely Hidden Loading Overlay
        LoadingOverlay:
            id: loading_overlay
            opacity: 0
            disabled: True
            size_hint: None, None
            size: 0, 0
            pos_hint: {'x': 2, 'y': 2}