#:import utils kivy.utils

<LoginScreen>:
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex('#F3F4F6')
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            width: dp(340)
            height: dp(420)
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            padding: dp(20)
            spacing: dp(15)
            
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(15)]
                    
            AnchorLayout:
                size_hint_y: None
                height: dp(80)
                anchor_x: 'center'
                anchor_y: 'center'
                Image:
                    source: 'assets/logo.jpeg'
                    size_hint: None, None
                    size: dp(70), dp(70)
                    allow_stretch: True
                    keep_ratio: False

            Label:
                text: 'Welcome Back\nLogin to continue'
                halign: 'center'
                valign: 'middle'
                font_size: '20sp'
                bold: True
                color: 0, 0, 0, 1
                size_hint_y: None
                height: dp(60)
                text_size: self.size
                
            BoxLayout:
                size_hint_y: None
                height: dp(50)
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#E5E7EB')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.x + 1, self.y + 1
                        size: self.width - 2, self.height - 2
                        radius: [dp(9)]
                        
                Label:
                    text: '[b]IN[/b]\n+91'
                    markup: True
                    halign: 'center'
                    valign: 'middle'
                    color: 0, 0, 0, 1
                    font_size: '12sp'
                    size_hint_x: None
                    width: dp(50)
                    text_size: self.size
                    
                Widget:
                    size_hint_x: None
                    width: dp(1)
                    canvas.before:
                        Color:
                            rgba: utils.get_color_from_hex('#E5E7EB')
                        Rectangle:
                            pos: self.x, self.y + 10
                            size: 1, self.height - 20
                            
                TextInput:
                    id: phone_input
                    hint_text: 'Enter mobile number'
                    hint_text_color: utils.get_color_from_hex('#9CA3AF')
                    background_color: 0,0,0,0
                    background_normal: ''
                    background_active: ''
                    cursor_color: 0,0,0,1
                    foreground_color: 0,0,0,1
                    font_size: '15sp'
                    input_type: 'number'
                    multiline: False
                    padding: [dp(15), dp(15), 0, 0]
                    
            Label:
                id: error_label
                text: ''
                color: 1, 0, 0, 1
                font_size: '12sp'
                size_hint_y: None
                height: dp(20)
                
            Button:
                text: 'Login with OTP'
                size_hint_y: None
                height: dp(50)
                background_color: 0,0,0,0
                background_normal: ''
                color: 1, 1, 1, 1
                bold: True
                font_size: '16sp'
                on_release: root.request_login()
                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex('#0B8733')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]
                        
            Button:
                text: "Don't have an account? [color=#0B8733][b]Sign Up[/b][/color]"
                markup: True
                size_hint_y: None
                height: dp(30)
                background_color: 0,0,0,0
                background_normal: ''
                color: utils.get_color_from_hex('#6B7280')
                on_release:
                    app.root.current = 'register'
                    app.root.transition.direction = 'left'
            
            Widget:
                size_hint_y: 1
                
        LoadingOverlay:
            id: loading_overlay
            opacity: 0
            pos_hint: {'x': 10}
